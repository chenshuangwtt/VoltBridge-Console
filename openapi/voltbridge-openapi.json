              "format": "int32"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Platform lifecycle state",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["STARTING", "CHARGING", "ENDING", "COMPLETED", "START_FAILED", "ABORTED"]
