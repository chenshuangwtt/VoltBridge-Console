  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Tariffs",
      "description": "Versioned fixed-rate and time-of-use tariff management"
    },
    {
      "name": "Billing",
      "description": "Fixed-rate MVP billing records"
    },
    {
      "name": "Commands",
      "description": "Asynchronous DeviceCommand lifecycle queries"
    },
    {
      "name": "Devices",
      "description": "Device lookup and asynchronous remote operations"
    },
    {
      "name": "Charging transactions",
      "description": "Platform-level charging transaction lifecycle and queries"
    },
    {
      "name": "Fallback tariff",
      "description": "System-managed fixed tariff used when no scheduled tariff matches."
    }
  ],
  "paths": {
    "/api/tenants/{tenantId}/fallback-tariff/revisions": {
      "post": {
        "tags": ["Fallback tariff"],
        "summary": "Schedule a fallback price revision",
        "description": "Atomically closes the current FALLBACK revision at switchAt and creates the next all-day FIXED revision. The role, currency, timezone, and full-day period are system controlled.",
        "operationId": "createRevision",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFallbackTariffRevisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseTariffPlanView"
                }
              }
            }
          }
        }
      }
    },
    "/api/tariffs": {
      "get": {
        "tags": ["Tariffs"],
        "summary": "List tenant tariff revisions",
        "operationId": "list",
        "parameters": [
          {
            "name": "tenantId",
            "in": "query",
            "description": "Tenant UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListTariffPlanView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid tariff or business rule rejection; response uses the ApiResponse failure envelope",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tariffs"],
        "summary": "Create a scheduled tariff plan",
        "description": "Creates a SCHEDULED draft tariff whose periods cover the complete local day. FALLBACK tariffs are system initialized and cannot be created through this endpoint.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTariffPlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseTariffPlanView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid tariff or business rule rejection; response uses the ApiResponse failure envelope",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tariffs/{tariffPlanId}/revisions": {
      "post": {
        "tags": ["Tariffs"],
        "summary": "Create the next scheduled tariff revision",
        "description": "Creates an immutable SCHEDULED draft revision in the source family. FALLBACK revisions must use the tenant fallback revision endpoint.",
        "operationId": "createRevision_1",
        "parameters": [
          {
            "name": "tariffPlanId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTariffRevisionRequest"
              }
            }
