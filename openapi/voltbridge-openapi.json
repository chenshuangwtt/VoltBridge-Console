  "components": {
    "schemas": {
      "CreateFallbackTariffRevisionRequest": {
        "type": "object",
        "description": "Price and effective switch instant for a new fallback revision",
        "properties": {
          "switchAt": {
            "type": "string",
            "format": "date-time"
          },
          "energyPricePerKwh": {
            "type": "number",
            "minimum": 0
          },
          "serviceFeePerKwh": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["energyPricePerKwh", "serviceFeePerKwh", "switchAt"]
      },
      "ApiResponseTariffPlanView": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/TariffPlanView"
          }
        }
      },
      "TariffPeriodView": {
        "type": "object",
        "properties": {
          "sequenceNo": {
            "type": "integer",
            "format": "int32"
          },
          "periodType": {
            "type": "string"
          },
          "startMinute": {
            "type": "integer",
            "format": "int32"
