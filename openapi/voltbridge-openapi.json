  "info": {
    "title": "VoltBridge API",
    "description": "REST API for device operations, charging transactions, tariffs and billing.",
    "license": {
      "name": "Apache License 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
