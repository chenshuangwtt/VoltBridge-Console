# 浏览器侧 API Base。
# 开发环境留空，使用相对路径 /api、/actuator，经 Vite proxy 转发。
VITE_API_BASE_URL=

# 默认租户，可选。
VITE_DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111111

# Vite 开发代理目标。后端地址变化时只改这里。
DEV_PROXY_TARGET=http://localhost:8080

# Vite 开发服务器端口。
DEV_PORT=5173

# 仅供 OpenAPI 同步脚本使用，不暴露给浏览器。
OPENAPI_URL=http://localhost:8080/v3/api-docs
